{
  "name": "frame",
  "version": "0.1.0",
  "private": true,
  "description": "实时语音陪伴 + 能执行任务的 AI 智能体。本地优先，BYOK，自带人格与记忆。",
  "main": "electron/main.mjs",
  "keywords": [
    "ai",
    "agent",
    "voice",
    "assistant",
    "byok",
    "openai-compatible",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node tools/doctor.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "build": {
    "appId": "com.frame.desktop",
    "productName": "frame",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "**/*",
      ".next/**/*",
      "!src/**",
      "!tests/**",
      "!tools/**",
      "!docs/**",
      "!release/**",
      "!*.md",
      "!fix-dev-deps.patch"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    }
  }
}
